{
  "name": "pts-workbench",
  "productName": "PTS Workbench",
  "version": "0.4.1",
  "description": "A more efficient way to work on cars. Works with Ford PTS + XTime.",
  "main": "src/main.js",
  "author": "Ashton Miller",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "release": "electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.ptsworkbench",
    "productName": "PTS Workbench",
    "generateUpdatesFilesForAllChannels": true,
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "createDesktopShortcut": true,
      "shortcutName": "PTS Workbench",
      "artifactName": "PTS-Workbench-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "PTS-Workbench-Portable-${version}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "AshtonCMiller",
      "repo": "pts-workbench",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "ptsWorkbench": {
    "syncUrl": "https://pts-sync.parkourdev.workers.dev",
    "feedbackAdmin": "95385"
  }
}
